import React, { useState, useEffect } from 'react';
import { useAuth } from '../context/AuthContext.jsx';
import Loading from '../components/Loading.jsx';
import toast from 'react-hot-toast';

const PreviousPapers = () => {
  const { user, api } = useAuth();
  const [papers, setPapers] = useState([]);
  const [loading, setLoading] = useState(true);
  const [showUploadForm, setShowUploadForm] = useState(false);
  const [filterSubject, setFilterSubject] = useState('');
  const [uploading, setUploading] = useState(false);
  const [selectedFile, setSelectedFile] = useState(null);
  const [formData, setFormData] = useState({
    title: '',
    subject: '',
    description: '',
    year: new Date().getFullYear()
  });

  useEffect(() => {
    fetchPapers();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  const fetchPapers = async () => {
    try {
      setLoading(true);
      // Fetch study materials with type "suggestion_paper"
      const response = await api.get('/study-materials');
      // Filter only suggestion papers
      const suggestionPapers = response.data.filter(m => m.type === 'suggestion_paper');
      setPapers(suggestionPapers);
      console.log('Fetched papers:', suggestionPapers);
    } catch (error) {
      toast.error('Failed to fetch papers');
      console.error('Fetch error:', error);
    } finally {
      setLoading(false);
    }
  };

  const handleFileSelect = (e) => {
    const file = e.target.files[0];
    if (file) {
      // Check file size (10MB limit)
      if (file.size > 10 * 1024 * 1024) {
        toast.error('File size must be less than 10MB');
        return;
      }
      // Check if it's a PDF
      if (!file.type.includes('pdf') && !file.name.toLowerCase().endsWith('.pdf')) {
        toast.error('Only PDF files are allowed');
        return;
      }
      setSelectedFile(file);
    }
  };

  const handleSubmit = async (e) => {
    e.preventDefault();

    if (!selectedFile) {
      toast.error('Please select a PDF file');
      return;
    }

    try {
      setUploading(true);

      // Upload file first
      const formDataFile = new FormData();
      formDataFile.append('file', selectedFile);

      const uploadResponse = await api.post('/study-materials/upload', formDataFile, {
        headers: {
          'Content-Type': 'multipart/form-data',
        },
      });

      const fileUrl = uploadResponse.data.fileUrl;

      // Create study material with type "suggestion_paper"
      const payload = {
        title: formData.title,
        subject: formData.subject,
        description: formData.description || `${formData.year} Suggestion Paper`,
        type: 'suggestion_paper',
        fileUrl: fileUrl,
        tags: [formData.year.toString(), 'suggestion', 'previous-paper']
      };

      await api.post('/study-materials', payload);
      
      toast.success('Paper uploaded successfully!');
      resetForm();
      fetchPapers();
    } catch (error) {
      toast.error(error.response?.data?.message || 'Failed to upload paper');
      console.error('Upload error:', error);
    } finally {
      setUploading(false);
    }
  };

  const handleDownload = async (paper) => {
    try {
      if (!paper.fileUrl) {
        toast.error('No file available for download');
        return;
      }

      const fileUrl = paper.fileUrl.startsWith('/uploads/') 
        ? `http://localhost:5001${paper.fileUrl}`
        : paper.fileUrl;
      
      // Download file
      const response = await fetch(fileUrl);
      const blob = await response.blob();
      
      const url = window.URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `${paper.title}.pdf`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      window.URL.revokeObjectURL(url);
      
      toast.success('Downloaded successfully!');
    } catch (error) {
      toast.error('Failed to download file');
      console.error('Download error:', error);
    }
  };

  const handleDelete = async (id) => {
    if (!window.confirm('Are you sure you want to delete this paper?')) return;

    try {
      await api.delete(`/study-materials/${id}`);
      toast.success('Paper deleted successfully!');
      fetchPapers();
    } catch (error) {
      toast.error('Failed to delete paper');
    }
  };

  const resetForm = () => {
    setFormData({
      title: '',
      subject: '',
      description: '',
      year: new Date().getFullYear()
    });
    setSelectedFile(null);
    setShowUploadForm(false);
  };

  const filteredPapers = papers.filter(p => 
    !filterSubject || p.subject.toLowerCase().includes(filterSubject.toLowerCase())
  );

  if (loading) {
    return <Loading fullScreen text="Loading suggestion papers..." />;
  }

  return (
    <div className="min-h-screen bg-gray-50 dark:bg-dark-950">
      <div className="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
        {/* Header */}
        <div className="mb-6 md:mb-8">
          <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <div>
              <h1 className="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">
                📝 Suggestion Papers
              </h1>
              <p className="mt-2 text-sm md:text-base text-gray-600 dark:text-gray-400">
                {user.role === 'teacher' 
                  ? 'Upload suggestion papers (PDFs) for students'
                  : 'Download suggestion papers uploaded by teachers'}
              </p>
            </div>
            {user.role === 'teacher' && (
              <button
                onClick={() => setShowUploadForm(!showUploadForm)}
                className="w-full sm:w-auto inline-flex items-center justify-center px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white rounded-lg transition-colors shadow-md text-sm md:text-base whitespace-nowrap"
              >
                {showUploadForm ? '✕ Cancel' : '+ Upload Paper'}
              </button>
            )}
          </div>
        </div>

        {/* Upload Form (Teacher Only) */}
        {user.role === 'teacher' && showUploadForm && (
          <div className="bg-white dark:bg-dark-800 rounded-lg shadow-md p-4 md:p-6 mb-6">
            <h2 className="text-lg md:text-xl font-bold text-gray-900 dark:text-white mb-4">
              Upload New Suggestion Paper
            </h2>
            <form onSubmit={handleSubmit} className="space-y-4">
              <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                    Paper Title *
                  </label>
                  <input
                    type="text"
                    required
                    value={formData.title}
                    onChange={(e) => setFormData({ ...formData, title: e.target.value })}
                    placeholder="e.g., Mathematics Final Exam"
                    className="w-full px-4 py-2 border border-gray-300 dark:border-dark-600 rounded-lg bg-white dark:bg-dark-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary-500"
                  />
                </div>

                <div>
                  <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                    Subject *
                  </label>
                  <input
                    type="text"
                    required
                    value={formData.subject}
                    onChange={(e) => setFormData({ ...formData, subject: e.target.value })}
                    placeholder="e.g., Mathematics"
                    className="w-full px-4 py-2 border border-gray-300 dark:border-dark-600 rounded-lg bg-white dark:bg-dark-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary-500"
                  />
                </div>
              </div>

              <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                    Year
                  </label>
                  <input
                    type="number"
                    value={formData.year}
                    onChange={(e) => setFormData({ ...formData, year: parseInt(e.target.value) })}
                    placeholder="2024"
                    min="2000"
                    max="2100"
                    className="w-full px-4 py-2 border border-gray-300 dark:border-dark-600 rounded-lg bg-white dark:bg-dark-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary-500"
                  />
                </div>

                <div>
                  <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                    Description (optional)
                  </label>
                  <input
                    type="text"
                    value={formData.description}
                    onChange={(e) => setFormData({ ...formData, description: e.target.value })}
                    placeholder="e.g., Final semester exam"
                    className="w-full px-4 py-2 border border-gray-300 dark:border-dark-600 rounded-lg bg-white dark:bg-dark-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary-500"
                  />
                </div>
              </div>

              {/* PDF Upload */}
              <div className="border-2 border-dashed border-primary-300 dark:border-primary-600 rounded-lg p-6 bg-primary-50 dark:bg-dark-700">
                <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  📄 Upload PDF File *
                </label>
                <input
                  type="file"
                  onChange={handleFileSelect}
                  accept=".pdf"
                  required
                  className="block w-full text-sm text-gray-500 dark:text-gray-400
                    file:mr-4 file:py-2 file:px-4
                    file:rounded-lg file:border-0
                    file:text-sm file:font-semibold
                    file:bg-primary-600 file:text-white
                    hover:file:bg-primary-700"
                />
                {selectedFile && (
                  <p className="mt-2 text-sm text-green-600 dark:text-green-400">
                    ✓ Selected: <strong>{selectedFile.name}</strong> ({(selectedFile.size / 1024 / 1024).toFixed(2)} MB)
                  </p>
                )}
              </div>

              <div className="flex flex-col sm:flex-row gap-3">
                <button
                  type="submit"
                  disabled={uploading || !selectedFile}
                  className="w-full sm:w-auto px-6 py-2 bg-primary-600 hover:bg-primary-700 text-white rounded-lg transition-colors disabled:bg-gray-400 disabled:cursor-not-allowed"
                >
                  {uploading ? 'Uploading...' : 'Upload Paper'}
                </button>
                <button
                  type="button"
                  onClick={resetForm}
                  disabled={uploading}
                  className="w-full sm:w-auto px-6 py-2 bg-gray-300 hover:bg-gray-400 text-gray-800 rounded-lg transition-colors"
                >
                  Cancel
                </button>
              </div>
            </form>
          </div>
        )}

        {/* Filter */}
        <div className="bg-white dark:bg-dark-800 rounded-lg shadow-md p-4 mb-6">
          <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
            Filter by Subject
          </label>
          <input
            type="text"
            value={filterSubject}
            onChange={(e) => setFilterSubject(e.target.value)}
            placeholder="Enter subject name..."
            className="w-full md:w-1/2 px-4 py-2 border border-gray-300 dark:border-dark-600 rounded-lg bg-white dark:bg-dark-900 text-gray-900 dark:text-white"
          />
        </div>

        {/* Papers List */}
        {filteredPapers.length === 0 ? (
          <div className="bg-white dark:bg-dark-800 rounded-lg shadow-md p-12 text-center">
            <svg className="w-16 h-16 text-gray-300 dark:text-dark-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <h3 className="text-lg font-medium text-gray-900 dark:text-white mb-2">No Papers Available</h3>
            <p className="text-gray-600 dark:text-gray-400">
              {user.role === 'teacher' 
                ? 'Upload your first suggestion paper to get started.'
                : 'No suggestion papers have been uploaded yet.'}
            </p>
          </div>
        ) : (
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {filteredPapers.map((paper) => (
              <div key={paper._id} className="bg-white dark:bg-dark-800 rounded-lg shadow-md hover:shadow-lg transition-shadow overflow-hidden">
                <div className="p-6">
                  <div className="flex items-start justify-between mb-3">
                    <span className="text-4xl">📄</span>
                    <span className="px-2 py-1 bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200 rounded-full text-xs font-medium">
                      Suggestion Paper
                    </span>
                  </div>
                  
                  <h3 className="text-lg font-semibold text-gray-900 dark:text-white mb-2">
                    {paper.title}
                  </h3>
                  
                  <p className="text-sm text-gray-600 dark:text-gray-400 mb-3 line-clamp-2">
                    {paper.description || 'Suggestion paper for exam preparation'}
                  </p>

                  <div className="flex items-center justify-between text-sm text-gray-500 dark:text-gray-400 mb-4">
                    <span className="font-medium">📚 {paper.subject}</span>
                    {paper.tags && paper.tags.find(t => /^\d{4}$/.test(t)) && (
                      <span className="font-medium">📅 {paper.tags.find(t => /^\d{4}$/.test(t))}</span>
                    )}
                  </div>

                  <div className="text-xs text-gray-500 dark:text-gray-400 mb-4">
                    <p>👨‍🏫 By: {paper.teacher?.name}</p>
                    <p>📅 {new Date(paper.createdAt).toLocaleDateString()}</p>
                  </div>

                  <div className="flex gap-2">
                    {paper.fileUrl && (
                      <button
                        onClick={() => handleDownload(paper)}
                        className="flex-1 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm text-center transition-colors font-medium"
                      >
                        📥 Download PDF
                      </button>
                    )}
                    {user.role === 'teacher' && paper.teacher._id === user._id && (
                      <button
                        onClick={() => handleDelete(paper._id)}
                        className="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg text-sm transition-colors"
                      >
                        🗑️
                      </button>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  );
};

export default PreviousPapers;
